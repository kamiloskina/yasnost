# Токен бота от @BotFather. Никогда не коммить настоящий токен.
BOT_TOKEN=123456:replace-me

# По умолчанию локальная SQLite. На Railway подставится PostgreSQL автоматически.
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# Режим оплаты: test — администраторам кнопка «тестовый доступ» без денег, остальным «оплата скоро»;
# off — оплата закрыта для всех, бот записывает интерес.
PAYMENT_MODE=test

# Цена курса в рублях (показывается в текстах)
PRICE_RUB=990

# Во сколько по местному времени приходит следующий день
DELIVERY_HOUR=9
DEFAULT_TIMEZONE=Europe/Moscow

# Telegram ID администраторов через запятую. Только им доступны /next, /reset, /stats, /autopost,
# /voice, /refund и тестовый доступ. Узнать свой ID: @userinfobot
ADMIN_IDS=


# --- Реальная оплата ---
# PAYMENT_MODE=yookassa — рубли через ЮKassa (токен: @BotFather → бот → Payments → ЮKassa)
# YOOKASSA_PROVIDER_TOKEN=
# YOOKASSA_SEND_RECEIPT=false   # true — просить e-mail и передавать чек в ЮKassa (54-ФЗ)
# PAYMENT_MODE=stars — оплата звёздами Telegram
# STARS_PRICE=650

# Ссылки на документы (показываются перед оплатой и в /terms)
# OFFER_URL=https://telegra.ph/...
# PRIVACY_URL=https://telegra.ph/...
# CONSENT_URL=https://telegra.ph/...
# Все три обязательны при PAYMENT_MODE=yookassa или stars.

# --- Автопостинг в канал (бот должен быть админом канала с правом публикации) ---
# AUTOPOST=false
# CHANNEL_ID=@onaotkrytaya

# --- Трекер на 30 дней ---
# TRACKER_PRICE_RUB=490
# TRACKER_STARS_PRICE=320   # обязателен при PAYMENT_MODE=stars

# Продажи курса (дни 2-7). false - курс пока не продаётся (например, пока не готовы аудиопрактики),
# а трекер продаётся. Администраторы могут проверять покупку курса и при false.
# COURSE_SALES=true

# --- Предзаказ дней 2-7 ---
# Первые PRESALE_LIMIT оплат - по цене PRESALE_PRICE_RUB (0 или пусто - предзаказа нет).
# Бот показывает, сколько мест осталось. Тестовые оплаты места не занимают.
# PRESALE_PRICE_RUB=490
# PRESALE_LIMIT=20
# Дата, с которой начинают приходить дни 2-7 (в DELIVERY_HOUR). Пусто - сразу после оплаты.
# С этой даты этап уходит только вместе с аудиопрактикой; если записи нет, бот ждёт и пишет админу.
# COURSE_START=2026-11-20

# --- Оплата на странице ЮKassa (рекомендуется) ---
# PAYMENT_MODE=yookassa_api
# YOOKASSA_SHOP_ID=      (кабинет ЮKassa -> Интеграция -> Ключи API)
# YOOKASSA_SECRET_KEY=   (хранить как СЕКРЕТ в Amvera)
# RETURN_URL=https://t.me/Clarity7DaysBot   (куда вернуть человека после оплаты)
